st.set_page_config(page_title="Hub de Auditoría - Conmet", page_icon="🕵️‍♂️", layout="wide")

st.sidebar.markdown(
    """
    <div style="position: fixed; bottom: 10px; left: 10px; font-size: 10px; color: gray;">
